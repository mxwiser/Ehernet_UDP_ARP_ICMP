`ifndef AXIS_INTERFACE
`define AXIS_INTERFACE
interface axis(
    logic  [7:0] tdata,
    logic        tvalid,
    logic        tready,
    logic        tlast,
    logic        tuser,
);
modport master(
    output tdata,
    output tvalid,
    input  tready,
    output tlast,
    output tuser
);
modport slave(
    input  tdata,
    input  tvalid,
    output tready,
    input  tlast,
    input  tuser
);

endinterface 



`endif //AXIS_INTERFACE